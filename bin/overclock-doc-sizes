#!/usr/bin/env python3
"""Lists the process docs that every agent reads and flags the ones that grew too big.

Agents read CLAUDE.md, .claude/overclock.md and the docs in .claude/docs/ before working, so
every kilobyte there is paid on every task. A doc over the limit should be split by topic (the
planner plans that as a task); decisions.md stays one line per decision.

Usage (anywhere inside the project):
    overclock-doc-sizes             # limit 40 KB per file
    overclock-doc-sizes --limit 30
Exit code: 0 if every file is under the limit, 1 otherwise.
"""
import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "scripts"))
from overclock_lib import require_root  # noqa: E402


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("--limit", type=int, default=40, help="limit per file, in KB (default 40)")
    args = ap.parse_args()
    root = require_root()
    files = [root / "CLAUDE.md", root / ".claude" / "overclock.md"]
    files += sorted((root / ".claude" / "docs").rglob("*.md"))
    files += sorted((root / ".claude" / "roles").glob("*.md"))
    over = 0
    for path in files:
        if not path.is_file():
            continue
        kb = path.stat().st_size / 1024
        flag = "OVER" if kb > args.limit else "ok"
        over += flag == "OVER"
        print(f"{flag:4} {kb:7.1f} KB  {path.relative_to(root)}")
    print(f"{over} file(s) over {args.limit} KB")
    return 1 if over else 0


if __name__ == "__main__":
    sys.exit(main())
